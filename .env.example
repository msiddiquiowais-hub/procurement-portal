# Procurement Portal — local environment
# Copy to `.env` and adjust for your laptop.

# ─── Postgres (Docker stack on host port 55432) ────────────────────────────────
DB_HOST=localhost
DB_PORT=55432
DB_USER=proc
DB_PASSWORD=proc_local
DB_NAME=procurementDB

# ─── Backend API ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=33001
API_JWT_SECRET=dev-only-jwt-secret-change-me
API_JWT_TTL=12h
API_CORS_ORIGINS=http://localhost:33002,http://localhost:33003,http://localhost:33004

# ─── Web apps (Next.js) ───────────────────────────────────────────────────────
WEB_ADMIN_PORT=33002
SUPPLIER_PORT=33003
ONBOARDING_PORT=33004
NEXT_PUBLIC_API_BASE=http://localhost:33001

# ─── D365 F&O ─────────────────────────────────────────────────────────────────
# Stub by default. Provide real credentials to enable live push.
D365_BASE_URL=
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_COMPANY=PKE
D365_MODE=stub

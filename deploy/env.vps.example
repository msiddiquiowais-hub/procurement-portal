# deploy/env.vps.example — TEMPLATE. Copy to deploy/env.vps and edit.
#
#   cp deploy/env.vps.example deploy/env.vps
#
# deploy/env.vps is NOT in git (see .gitignore). It holds the VPS passwords and
# the real JWT secret, so it must never be committed.
#
# ── The four values you must change ──────────────────────────────────────────
#   1. DB_PASSWORD          — postgres password for the VPS instance
#   2. API_JWT_SECRET       — long random string, NOT the dev default
#   3. VPS_IP               — the server's public address (appears in 3 places)
#   4. API_CORS_ORIGINS     — must exactly match the two web origins

# ─── Addresses ───────────────────────────────────────────────────────────────
# Put the VPS IP in. If you later add a domain, change these three together or
# the browser's API calls will be rejected by CORS.
VPS_IP=203.0.113.10

WEB_PUBLIC_PORT=8080
ONBOARDING_PUBLIC_PORT=8081
API_PUBLIC_PORT=8082

# Baked into the browser bundle at build time — must be reachable from a
# tester's laptop, not from inside the VPS.
NEXT_PUBLIC_API_BASE=http://${VPS_IP}:8082

# Used by the API to build links in e-mail / acknowledgement messages.
PUBLIC_WEB_URL=http://${VPS_IP}:8080

# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=proc
DB_PASSWORD=CHANGE_ME_strong_postgres_password
DB_NAME=procurementDB

# Must be the container NAME, because DbService runs
# `docker exec -i $PG_CONTAINER psql`. Changing this breaks every DB call.
PG_CONTAINER=procurement-portal-db

# ─── API ─────────────────────────────────────────────────────────────────────
# Generate a real one with:  openssl rand -base64 48
API_JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
API_JWT_TTL=12h

# Exact origins the browser will send. No trailing slash, no path, comma-separated.
# If a tester gets a CORS error in the browser console, it is a mismatch here.
API_CORS_ORIGINS=http://${VPS_IP}:8080,http://${VPS_IP}:8081

# ─── Storage ─────────────────────────────────────────────────────────────────
# Roots are set in docker-compose.vps.yml to /data/... inside a named volume.
# These are bucket labels for the local disk adapter.
ATTACHMENT_STORAGE_BUCKET=local

# ─── D365 F&O ────────────────────────────────────────────────────────────────
# stub = no external calls, fully self-contained. Use this for the test VPS
# unless you have been asked to integrate with a real tenant.
D365_MODE=stub
D365_BASE_URL=
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_COMPANY=PKE

# ─── Misc ────────────────────────────────────────────────────────────────────
# Demo helper endpoints. Leave 0 for a shared test environment.
DEMO_HELPERS=0